# ==========================================
# Network Monitor & Homelab Topology Settings
# ==========================================

PORT=3000

# Proxmox VE API Configuration
PVE_HOST=192.168.1.99:8006
PVE_USER=root@pam
PVE_PASS=YourProxmoxPasswordHere

# Network Gateway & Subnet for ARP Scanning
GATEWAY=192.168.1.1
SUBNET=192.168.1.

# Tailscale Integration (Fetch status remotely via SSH)
TS_SSH_USER=root
TS_SSH_PASS=YourVpnHostPasswordHere
TS_SSH_HOST=192.168.1.104

# Zero-Leak 2FA Telegram Gate & Security Shield
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# SHA-256 hash of your master web dashboard password
# Example: echo -n 'YourPassword' | sha256sum
MASTER_PASSWORD_HASH=a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3
